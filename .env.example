# COPY THIS FILE TO .env.local AND FILL IN THE VALUES. NEVER COMMIT .env.local.

# SUPABASE (dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://qeuvxnvwommyjdzxoodd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never expose to the browser.
SUPABASE_SECRET_KEY=
# Server only: how `npm run db:migrate` reaches the database. Set ONE of these.
# Personal access token (supabase.com/dashboard/account/tokens); runs SQL over HTTPS,
# so it also works where Postgres connections are blocked (Claude cloud sessions).
SUPABASE_ACCESS_TOKEN=
# Postgres connection: Dashboard > Connect > Session pooler (port 5432), with your
# database password filled in.
SUPABASE_DB_URL=

# Server only: the key scripts and shortcuts send to POST /api/capture as
# `Authorization: Bearer <key>`. Empty means only signed-in sessions may call it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECOND_BRAIN_API_KEY=

# AI: NVIDIA Nemotron on Nebius Token Factory
NEBIUS_API_KEY=

# OpenRouter models appear as openrouter/<provider>/<model> in Settings.
OPENROUTER_API_KEY=
# Optional image model. Must appear in OpenRouter's /images/models catalogue.
OPENROUTER_IMAGE_MODEL=qwen/qwen-image-2.1-turbo
# Separate scalable vector artwork tool.
OPENROUTER_VECTOR_MODEL=recraft/recraft-v4.1-pro-vector

# Composer assesses changed articles automatically on an always-on Node server.
# Set false to disable the background worker. Serverless schedulers can POST to
# /api/composer/process with the existing PROCESSING_WORKER_KEY.
COMPOSER_AUTO_ENABLED=true
# Optional: the model id. Empty means the default, nvidia/nemotron-3-super-120b-a12b.
AI_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional: the model that embeds claims for duplicate detection (1024-dim vectors).
# Empty means Qwen/Qwen3-Embedding-8B. Changing it re-embeds every claim on the next upload.
AI_EMBEDDING_MODEL=
# Optional: Cerebras (https://cloud.cerebras.ai) as a second chat provider. When set, its models appear
# in Settings > Model as "cerebras/<id>". Embeddings and image reading still use NEBIUS_API_KEY.
CEREBRAS_API_KEY=
# Optional: Claude (https://platform.claude.com) as a third chat provider. When set, its models appear
# in Settings > Model as "anthropic/<id>" (e.g. anthropic/claude-opus-5-5). Embeddings still use NEBIUS_API_KEY.
ANTHROPIC_API_KEY=

# Optional: web search for external knowledge (https://tavily.com), used by Force Create and by any AI article build
# when Settings > Features allows it and a section's own sources are thin. Empty means Wikipedia only (free, no key).
TAVILY_API_KEY=
# Optional: set to hybrid to rank chat search with meaning, keyword and link search fused by RRF. Empty means legacy.
CHAT_SEARCH=
# Optional: set to voyage to re-sort chat search results with Voyage AI. Empty means off.
CHAT_RERANKER=
# Optional: Voyage AI key (https://dash.voyageai.com) for the reranker. Used only when CHAT_RERANKER=voyage.
VOYAGE_API_KEY=
# Optional: duplicate checks drop clearly unrelated candidates with a free local NLI model
# (cross-encoder/nli-deberta-v3-base, about 200 MB, downloaded on first use) before their AI call.
# Empty means on; set to off to skip it. Tests leave it off unless this is on.
DEDUP_NLI=
# Optional: the model that describes uploaded images. Empty means nvidia/Nemotron-3.5-Super-VL.
AI_VISION_MODEL=
# Optional: video transcripts. Whisper runs in the app server (Token Factory has no speech-to-text);
# empty means onnx-community/whisper-base, downloaded on first use. Language empty means English.
AI_TRANSCRIBE_MODEL=
AI_TRANSCRIBE_LANGUAGE=
# Optional: the ffmpeg binary that reads videos. Empty means the one ffmpeg-static installs.
FFMPEG_PATH=

# Processing request budgets shared across requests in one Node process.
PROCESSING_CHAT_CONCURRENCY=3
PROCESSING_EMBEDDING_CONCURRENCY=2
PROCESSING_SEARCH_CONCURRENCY=4
PROCESSING_WEB_CONCURRENCY=4
# Always-on Node: recovery runs by default; false disables the timer.
# Serverless: POST /api/processing/recover from
# a scheduler with Authorization: Bearer <PROCESSING_WORKER_KEY> instead.
PROCESSING_RECOVERY_ENABLED=true
PROCESSING_WORKER_KEY=
# Enable on every instance after the recovery migration for deployment-wide budgets.
PROCESSING_SHARED_LIMITS=false

# Optional: the address the Contact page, the legal pages and the footer link to (mailto).
# Shown only while the legal_pages flag is on; empty means no Contact page (a 404).
NEXT_PUBLIC_CONTACT_EMAIL=

# Billing (behind the `billing` feature flag): the Stripe secret key, the signing
# secret of the webhook endpoint (POST /api/billing/webhook), and one price id per plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# Optional: Gmail import (Settings > Gmail, behind the gmail_import feature flag). A Google OAuth web client
# (console.cloud.google.com > APIs & Services > Credentials) with the Gmail API enabled; the app asks only for
# the gmail.readonly scope. Authorized redirect URI: <your origin>/api/gmail/callback.
GOOGLE_CLIENT_ID=
# Server only: never expose to the browser.
GOOGLE_CLIENT_SECRET=
# Optional: the redirect URI sent to Google. Empty means <request origin>/api/gmail/callback.
GOOGLE_REDIRECT_URI=
# Server only: 32 random bytes (base64) that encrypt the stored Google tokens. Changing it means connecting again.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_KEY=
